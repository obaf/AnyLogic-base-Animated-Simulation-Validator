			<StatechartElements>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1704562197209</Id>
					<Name><![CDATA[idle]]></Name>
					<X>180</X><Y>110</Y>
					<Label><X>10</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="160" Height="30">
						<EntryAction><![CDATA[/*
if(ridePlan.size()==0){
	//car.setVisible(false);
	car.setColor("Material__4_Surf", white);
}
*/

/* if vehicle has this state, means no passengers. */
//checkIfNextRideIsWaiting();
defineFirstRideEvent();

if (ridesPlan.indexOf(currentRide)==ridesPlan.size()-1){
	endOfRides=true;
	main.checkIfEnd();
}]]></EntryAction>
						<FillColor>-4144960</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1704562211318</Id>
					<Name><![CDATA[movingToDestination]]></Name>
					<X>180</X><Y>190</Y>
					<Label><X>5</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="160" Height="30">
						<EntryAction><![CDATA[checkNextRide();

moveTo(currentRide.getDestLat(), currentRide.getDestLon());

if (currentRide.getVehicleAction().equals("pickup")){
	send("request ride", currentRide.getPassenger());
}

//Add this instance of RideInfo to the collection in main
main.ridesColl.add(currentRide);



//collect stats
currentRide.setInitLat(this.getLatitude());
currentRide.setInitLon(this.getLongitude());

Calendar departureTime=Calendar.getInstance();
departureTime.setTime(date());
currentRide.setDepartureTime(departureTime);]]></EntryAction>
						<FillColor>-4980813</FillColor>
					</Properties>
				</StatechartElement>
				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1704570311240</Id>
					<Name><![CDATA[load_unload]]></Name>
					<X>180</X><Y>280</Y>
					<Label><X>10</X><Y>15</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="160" Height="30">
						<EntryAction><![CDATA[if (currentRide.getVehicleAction().equals("pickup")) {
	// pickup
	passengerNumberInCar+= currentRide.getNumPassengers();
	send("ride start", currentRide.getPassenger());
		
	//traceln("pickup");

}else if (currentRide.getVehicleAction().equals("dropoff")) {
	// dropoff
	passengerNumberInCar -= currentRide.getNumPassengers();
	/*send("done", dest);rideRequestLink.getConnections()
			.forEach(a -> a.statechart.fireEvent("done"));*/
			
	//traceln("dropoff");
}

if (passengerNumberInCar>capacity){
	currentRide.setMessage("over-capacity");
}else if (passengerNumberInCar<0){
	currentRide.setMessage("negative-capacity");
}

Double travelKm = getDistanceGIS(
		currentRide.getInitLat(),
		currentRide.getInitLon(),
		currentRide.getDestLat(),
		currentRide.getDestLon(),
		KILOMETER	);

totalTravel += travelKm;

totalPassengers += currentRide.getNumPassengers();]]></EntryAction>
						<ExitAction><![CDATA[if (currentRide.getVehicleAction().equals("dropoff")) {
	send("arrived", currentRide.getPassenger());
	currentRide.getPassenger().setLatLon(currentRide.getDestLat(),
											currentRide.getDestLon());
}

//collect stats
Calendar arrivalTime=Calendar.getInstance();
arrivalTime.setTime(date());
currentRide.setArrivalTime(arrivalTime);



if (currentRide.getVehicleAction().equals("dropoff")) {
	//get arrival time of the passenger pickup
	RideInfo pickUpInfo=findFirst(ridesPlan, 
									ri->ri.getPassengerId()==currentRide.getPassengerId());
	currentRide.setTimeSpentInVehicleMinutes(
		main.timeInMinutesBetweenCalendar(pickUpInfo.getArrivalTime(),
										currentRide.getArrivalTime()) );
}

currentRide.setDistanceToDestKm(
	getDistanceGIS(currentRide.getInitLat(), currentRide.getInitLon(),
					currentRide.getDestLat(), currentRide.getDestLon(),
					KILOMETER));

if (currentRide.getVehicleAction().equals("pickup")){
	//update waiting time
	currentRide.setWaitingTimeMinutes(
		main.timeInMinutesBetweenCalendar(currentRide.getRequestDate(),
											currentRide.getArrivalTime()) );
}]]></ExitAction>
						<FillColor/>
					</Properties>
				</StatechartElement>
