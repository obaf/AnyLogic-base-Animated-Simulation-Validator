					<Name><![CDATA[FirstRideDynamicEvent]]></Name>
					<X>550</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nextRide]]></Name>
						<Type><![CDATA[RideInfo]]></Type>
					</Parameter>
					<Action><![CDATA[send("move to destination", this);


scheduledFirstRide=null;]]></Action>
				</DynamicEventClass>
			</DynamicEvents>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714634021522</Id>
					<Name><![CDATA[defineFirstRideEvent]]></Name>
					<X>350</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*	Only when the vehicle is idle and have no passengers 
in the vehicle	*/


//index of current ride, to send nextRide to the dyamic event
int indexOfNextRide=ridesPlan.indexOf(currentRide)+1;
if (indexOfNextRide<ridesPlan.size()){
	RideInfo nextRide=ridesPlan.get(indexOfNextRide);
	//find time until event of next ride
	Calendar timeNow=Calendar.getInstance();
	timeNow.setTime(date());
	double timeDiffMinutes=main.timeInMinutesBetweenCalendar(timeNow,
															nextRide.getRequestDate());
	//create a new StartRideDynEvent
	scheduledFirstRide=create_FirstRideDynamicEvent(timeDiffMinutes,
													MINUTE, 
													nextRide);	
}	
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714635592753</Id>
					<Name><![CDATA[checkNextRide]]></Name>
					<X>350</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*
if (scheduledFirstRide==null && passengerNumberInCar==0){
	//means no scheduled start ride and no passengers 
		//so schedule the next one
	defineFirstRideEvent();
}else if (passengerNumberInCar>0){
	//means the car has passengers
}
*/

int indexOfNextRide=ridesPlan.indexOf(currentRide)+1;
RideInfo nextRide=ridesPlan.get(indexOfNextRide);
//traceln(id+" indexOfNextRide: "+indexOfNextRide);
currentRide=nextRide;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1714663896704</Id>
					<Name><![CDATA[checkIfNextRideIsWaiting]]></Name>
					<X>350</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[boolean isNextRideWaiting=false;
//index of current ride, to send nextRide to the dyamic event
int indexOfNextRide=ridesPlan.indexOf(currentRide)+1;
if (indexOfNextRide<ridesPlan.size()){
	RideInfo nextRide=ridesPlan.get(indexOfNextRide);
	//find time until event of next ride
	Calendar timeNow=Calendar.getInstance();
	timeNow.setTime(date());
	double timeDiffMinutes=main.timeInMinutesBetweenCalendar(timeNow,
															nextRide.getRequestDate());
	if (timeDiffMinutes<0){	
		isNextRideWaiting=true;
	}
	//traceln("nextRide.getRequestDate().getTime: "+nextRide.getRequestDate().getTime());
	//traceln("timeDiffMinutes: "+timeDiffMinutes);
}

//traceln("isNextRideWaiting: "+isNextRideWaiting);
return isNextRideWaiting;]]></Body>
				</Function>
			</Functions>
