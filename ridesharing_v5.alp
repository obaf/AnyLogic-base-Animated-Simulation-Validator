			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1704638822576</Id>
					<Name><![CDATA[getVehicleRidePlan]]></Name>
					<X>-100</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[//find all unique vehicles and create them
for (int i=0; i<rides_dbColl.size(); i++){

	Ride_db ride=rides_dbColl.get(i);
	Vehicle vehicle=findFirst(vehicles, v->v.id==ride.getVehicleId());
	if (vehicle==null){
		//vehicle does not exist, so create it
		vehicle=add_vehicles(ride.getVehicleId(), vehicleCapacity, loadUnloadTime);
		//create list of sequence
		ArrayList<RideInfo> sequence=new ArrayList<>();
		//add the first start Ride info
		InitialLocationInfo startRide= new InitialLocationInfo(ride.getVehicleInitLat(),
													ride.getVehicleInitLon());
		vehicle.initialLocInfo=startRide;

		/* iterate over the next i values to see the whole 
		sequence of the current vehicle */
		List<Ride_db> ridesOfVehicle=
			findAll(rides_dbColl, r->r.getVehicleId()==ride.getVehicleId());
			
		for (int j=0; j<ridesOfVehicle.size(); j++){
			Ride_db nextRide=ridesOfVehicle.get(j);

			double destLat=0;
			double destLon=0;			
			
			if (nextRide.getOriginLat()==0){
				//means no origin, but dest
				destLat=nextRide.getDestLat();
				destLon=nextRide.getDestLon();
			}else{
				//means origin
				destLat=nextRide.getOriginLat();
				destLon=nextRide.getOriginLon();
			}
			
			RideInfo nextRideInfo= new RideInfo(j,
											nextRide.getRequestDate(),
											nextRide.getRideId(),
											vehicle,
											null,
											nextRide.getPassengerId(),
											getActionString(nextRide.getVehicleAction()),
											destLat,
											destLon,
											nextRide.getNumPassengers(),
											//stats
											0,
											0,
											null,
											null,
											0,
											0,
											0,
											""	);
			sequence.add(nextRideInfo);
		}							
		vehicle.ridesPlan=sequence;
		vehicle.setLatLon(vehicle.initialLocInfo.getOriginLat(), 
							vehicle.initialLocInfo.getOriginLon());
		
		//start vehicle statechart
		send("start", vehicle);
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1704719662128</Id>
					<Name><![CDATA[createPassengers]]></Name>
					<X>-100</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[//find all unique vehicles and create them
for (int i=0; i<rides_dbColl.size(); i++){
	Ride_db ride=rides_dbColl.get(i);
	if (ride.getVehicleAction()==2){
		//means origin of the passenger
		//traceln("-ride.getPassengerId: "+ride.getPassengerId());
		RideRequest rr=add_rideRequests(ride.getPassengerId(), ride.getNumPassengers());
		rr.vehicleLink.connectTo(findFirst(vehicles, v->v.id==ride.getVehicleId()));
		rr.setLatLon(ride.getOriginLat(), ride.getOriginLon());
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714557189139</Id>
					<Name><![CDATA[initRides_dbColl]]></Name>
					<X>-100</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[List<Tuple> rows = selectFrom(new_input)
	.list();

for (Tuple row : rows) {
	Calendar cal=Calendar.getInstance();
	cal.setTime(row.get( new_input.date_time ));
	
	Ride_db ride= new Ride_db(
		cal,
		row.get( new_input.ride_id ),
		row.get( new_input.vehicle_id ),
		row.get( new_input.passenger_id ),
		row.get( new_input.vehicle_action ),
		row.get( new_input.vehicle_init_lat )!=null? row.get( new_input.vehicle_init_lat ): 0,
		row.get( new_input.vehicle_init_lon )!=null? row.get( new_input.vehicle_init_lon ): 0 ,
		row.get( new_input.origin_lat )!=null? row.get( new_input.origin_lat ): 0,
		row.get( new_input.origin_lon )!=null? row.get( new_input.origin_lon ): 0 ,
		row.get( new_input.dest_lat )!=null? row.get( new_input.dest_lat ): 0 ,
		row.get( new_input.dest_lon )!=null? row.get( new_input.dest_lon ): 0, 
		row.get( new_input.num_passengers )
	);
	
	rides_dbColl.add(ride);
}

//traceln("rides_dbColl: "+rides_dbColl);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1714559322828</Id>
					<Name><![CDATA[getActionString]]></Name>
					<X>-530</X><Y>0</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (action==0){
	return "empty trip";
}else if (action==1){
	return "dropoff";
}else if (action==2){
	return "pickup";
}else{
	error("Not valid action");
	return "";
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714659405597</Id>
					<Name><![CDATA[finishRideInfoSetup]]></Name>
					<X>-100</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Vehicle vehicle: vehicles){
	for (RideInfo ri: vehicle.ridesPlan){
		//traceln("ri.getPassengerId: "+ri.getPassengerId());
		RideRequest rideRequest= findFirst(rideRequests, rr->rr.id==ri.getPassengerId());
		//traceln("rideRequest: "+rideRequest);
		ri.setPassenger(rideRequest);
	}
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714664559953</Id>
					<Name><![CDATA[timeInMinutesBetweenCalendar]]></Name>
					<X>-530</X><Y>-20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[startDateVar]]></Name>
						<Type><![CDATA[Calendar]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[endDateVar]]></Name>
						<Type><![CDATA[Calendar]]></Type>
					</Parameter>
					<Body><![CDATA[long startTimeInMillis = startDateVar.getTimeInMillis();
long endTimeInMillis = endDateVar.getTimeInMillis();

long timeDifferenceInMillis = endTimeInMillis - startTimeInMillis;

double timeDifferenceInMinutes = timeDifferenceInMillis / (1000.0*60.0);

return timeDifferenceInMinutes;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1714679608907</Id>
					<Name><![CDATA[createRunId]]></Name>
					<Description><![CDATA[Return a unique runId for this simulation based on PID and timestamp.]]></Description>
					<X>-490</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[long pid = ProcessHandle.current().pid();

Timestamp ts = new Timestamp(System.currentTimeMillis());
SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy.MM.dd.HH.mm.ss");
String formattedTs = dateFormat.format(ts);

return "PID"+pid+"_"+formattedTs;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714679745092</Id>
					<Name><![CDATA[exportStatistics]]></Name>
					<X>-530</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int row=2;

double totalWaitingTime=0;
for(RideInfo ri: ridesColl){
	int col=1;
	String sheetName="sheet1";
	
	ridesExportFile.setCellValue(dateAsString(ri.getRequestDate()), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getRideId(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getVehicle().id, sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getPassengerId(), sheetName, row, col++);
	ridesExportFile.setCellValue(getActionInt(ri.getVehicleAction()), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getInitLat(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getInitLon(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getDestLat(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getDestLon(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getNumPassengers(), sheetName, row, col++);
	ridesExportFile.setCellValue(dateAsString(ri.getDepartureTime()), sheetName, row, col++);
	ridesExportFile.setCellValue(dateAsString(ri.getArrivalTime()), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getTimeSpentInVehicleMinutes(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getDistanceToDestKm(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getWaitingTimeMinutes(), sheetName, row, col++);
	ridesExportFile.setCellValue(ri.getMessage(), sheetName, row, col++);
	row++;
	
	totalWaitingTime+=ri.getWaitingTimeMinutes();
}

ridesExportFile.setCellValue(vehicles.sum("totalTravel"), "KPIs", 1, 2);
ridesExportFile.setCellValue(totalWaitingTime, "KPIs", 2, 2);



//datesExportFile.setFileName("exports/export_"+runId+"/patients_info.xlsx");
ridesExportFile.setFileName("exports/ridesExport_"+runId+".xlsx");
ridesExportFile.writeFile();
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1714681444840</Id>
					<Name><![CDATA[checkIfEnd]]></Name>
					<X>-530</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[for (Vehicle vehicle: vehicles){
	if (!vehicle.endOfRides){
		/*if at least one vehicle has not 
			ended its rides, then continue running */
		return;
	}
}

//if this code is reached, then end the simulation run
exportStatistics();

create_EndSimEvent(1, MINUTE);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1714681539206</Id>
					<Name><![CDATA[getActionInt]]></Name>
					<X>-530</X><Y>20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (action.equals("empty trip")){
	return 0;
}else if (action.equals("dropoff")){
	return 1;
}else if (action.equals("pickup")){
	return 2;
}else{
	error("Not valid action");
	return -1;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1714682840976</Id>
					<Name><![CDATA[dateAsString]]></Name>
					<X>-530</X><Y>40</Y>
