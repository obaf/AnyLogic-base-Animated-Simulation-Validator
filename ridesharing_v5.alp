					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[calendar]]></Name>
						<Type><![CDATA[Calendar]]></Type>
					</Parameter>
					<Body><![CDATA[SimpleDateFormat dateFormat = new SimpleDateFormat("dd-MM-yyyy HH:mm:ss");
String dateString = dateFormat.format(calendar.getTime());
return dateString;]]></Body>
				</Function>
